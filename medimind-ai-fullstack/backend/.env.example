PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGODB_URI=your-mongodb-connection-string
MONGODB_DB_NAME=medimind

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender-email
BREVO_SENDER_NAME=MediMind AI

# Fallback SMTP transport (used if Brevo is unavailable). For Gmail, use an
# app password and keep the default host/port, or set these explicitly.
SMTP_EMAIL=your-sender-email
SMTP_PASSWORD=your-smtp-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

UPLOAD_MAX_MB=15

# Private Cloudinary storage for Admin-approved medical knowledge base PDFs.
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_MEDICAL_KB_FOLDER=medimind/medical-knowledge-base

# -----------------------------------------------------------------------------
# RAG / LLM stack (NEW — required for real AI chat)
# -----------------------------------------------------------------------------
# Groq inference endpoint — get a key from https://console.groq.com/keys
# CRITICAL: rotate any previously-exposed GROQ_API_KEY before use.
GROQ_API_KEY=your-groq-api-key

# Current Groq-hosted chat model. See https://console.groq.com/docs/models for the
# up-to-date list; this may be changed without code changes. ragService.js also
# has a fallback chain (qwen/qwen3.8-27b → openai/gpt-oss-120b → openai/gpt-oss-20b
# → llama-3.1-70b-versatile → llama-3.3-70b-versatile) so if the primary 404s it
# tries the next one automatically.
# Confirmed working on a current Groq free-tier org (2026-09):
#   qwen/qwen3.8-27b         — 131k context, ~0.3s latency (fastest general chat)
#   openai/gpt-oss-120b      — 131k context, ~1.0s latency, larger model
#   openai/gpt-oss-20b       — 131k context
GROQ_MODEL=qwen/qwen3.8-27b

# Chroma server URL. Chroma's JS client is not embedded — this must point to a
# running Chroma process.
#   Local/dev:  `docker run -p 8000:8000 chromadb/chroma`
#   Production: Chroma Cloud free tier (https://trychroma.com) OR a separate
#               service. Render free tier does NOT bundle a Chroma container;
#               deploy chromadb/chroma as a second Render Web Service or use
#               Chroma Cloud. If unset, the backend will still boot but all
#               RAG retrievals will return empty results (no silent fallback).
CHROMA_URL=http://localhost:8000

# YouPI PG experimental one-time INR checkout (test/demo only).
# This service is self-hosted separately; never put merchant secrets in VITE_ variables.
YOUPI_API_URL=http://localhost:6100
YOUPI_MERCHANT_ID=
YOUPI_WEBHOOK_SECRET=

# Embedding model for transformers.js. Runs fully in-process in Node; no API
# calls. all-MiniLM-L6-v2 is the standard ~384-dim semantic search model.
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Hugging Face image screening. Configure only models verified against the
# serverless Inference API; otherwise imaging uploads are marked unavailable.
HF_API_TOKEN=your-huggingface-token
HF_XRAY_MODEL=
# Configure only a validated MRI-specific model. An X-ray model is never used as an MRI fallback.
HF_MRI_MODEL=

# ElevenLabs multilingual speech output. Keep the real key only in .env.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# -----------------------------------------------------------------------------
# OpenFDA Drug Label API (optional — raises rate limit from 240/hr per IP to higher)
# Get a key at https://open.fda.gov/apis/authentication/ — app fully works without this
OPENFDA_API_KEY=your-openfda-api-key-optional
